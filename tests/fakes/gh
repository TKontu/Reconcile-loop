#!/usr/bin/env python3
"""Offline stand-in for the GitHub CLI used by supervisor tests.

State comes from the JSON file named by FAKE_GH_STATE:
  {"prs": {branch: [pr, ...]}, "check_runs": {sha: [...]}, "statuses": {sha: [...]},
   "fail": ["substring of the joined argv", ...]}
Every call is appended to FAKE_GH_LOG as one JSON argv line. Unknown calls fail loudly.
"""

import json
import os
import sys

argv = sys.argv[1:]
with open(os.environ["FAKE_GH_LOG"], "a") as log:
    log.write(json.dumps(argv) + "\n")
with open(os.environ["FAKE_GH_STATE"]) as handle:
    state = json.load(handle)
joined = " ".join(argv)
if any(fragment in joined for fragment in state.get("fail", [])):
    print("fake gh: injected failure", file=sys.stderr)
    sys.exit(1)

if argv[:2] == ["pr", "list"]:
    branch = argv[argv.index("--head") + 1]
    print(json.dumps(state.get("prs", {}).get(branch, [])))
elif argv[:1] == ["api"]:
    path = next(a for a in argv[1:] if a.startswith("repos/"))
    sha = path.split("/commits/")[1].split("/")[0]
    key = "check_runs" if path.endswith("/check-runs") else "statuses"
    for item in state.get(key, {}).get(sha, []):
        print(json.dumps(item))
else:
    print(f"fake gh: unsupported call {argv}", file=sys.stderr)
    sys.exit(2)
