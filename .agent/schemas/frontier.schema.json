{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconcile-loop v1 frontier",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "source": {
      "type": "string",
      "minLength": 1
    },
    "source_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "status": {
            "enum": [
              "proposed",
              "ready",
              "active",
              "blocked",
              "done",
              "rejected"
            ]
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "acceptance": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "detail": {
            "type": "string",
            "minLength": 1
          },
          "priority": {
            "type": "string",
            "minLength": 1
          },
          "lane": {
            "type": "string",
            "minLength": 1
          },
          "extensions": {
            "type": "object",
            "description": "Project-specific namespaced policy; cannot override core invariants."
          }
        },
        "required": [
          "id",
          "status",
          "depends_on",
          "objective",
          "acceptance",
          "detail"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Project-specific namespaced policy; cannot override core invariants."
    }
  },
  "required": [
    "version",
    "source",
    "source_sha",
    "items"
  ],
  "additionalProperties": false
}
