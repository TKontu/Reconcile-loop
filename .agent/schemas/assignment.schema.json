{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconcile-loop v1 assignment",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "round_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "item": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
    },
    "base_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "runner": {
      "type": "string",
      "minLength": 1
    },
    "lane": {
      "type": "string",
      "minLength": 1
    },
    "branch": {
      "type": "string",
      "minLength": 1
    },
    "state": {
      "enum": [
        "planned",
        "dispatched",
        "running",
        "result-ready",
        "review",
        "needs-fix",
        "merge-ready",
        "merged",
        "blocked",
        "cancelled"
      ]
    },
    "spec": {
      "type": "string",
      "minLength": 1
    },
    "packet": {
      "type": "string",
      "minLength": 1
    },
    "spec_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "owned_records": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "resources": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "result": {
      "type": "string",
      "minLength": 1
    },
    "head_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "reviewed_head_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "review_ref": {
      "type": "string",
      "minLength": 1
    },
    "merged_sha": {
      "type": "string",
      "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$"
    },
    "reason": {
      "type": "string",
      "minLength": 1
    },
    "extensions": {
      "type": "object",
      "description": "Project-specific namespaced policy; cannot override core invariants."
    }
  },
  "required": [
    "version",
    "round_id",
    "id",
    "item",
    "base_sha",
    "runner",
    "lane",
    "branch",
    "state",
    "spec",
    "packet",
    "spec_sha256",
    "packet_sha256",
    "attempt",
    "owned_records",
    "resources"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "result-ready",
              "review",
              "needs-fix",
              "merge-ready",
              "merged"
            ]
          }
        }
      },
      "then": {
        "required": [
          "result",
          "head_sha"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "merge-ready",
              "merged"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reviewed_head_sha",
          "review_ref"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "const": "merged"
          }
        }
      },
      "then": {
        "required": [
          "merged_sha"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "state": {
            "enum": [
              "blocked",
              "cancelled",
              "needs-fix"
            ]
          }
        }
      },
      "then": {
        "required": [
          "reason"
        ]
      }
    }
  ]
}
