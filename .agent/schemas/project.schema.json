{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Reconcile-loop v1 project",
  "type": "object",
  "properties": {
    "version": {
      "const": 1
    },
    "default_branch": {
      "type": "string",
      "minLength": 1
    },
    "remote": {
      "type": "string",
      "minLength": 1
    },
    "paths": {
      "type": "object",
      "properties": {
        "readme": {
          "type": "string",
          "minLength": 1
        },
        "architecture": {
          "type": "string",
          "minLength": 1
        },
        "backlog": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "string",
          "minLength": 1
        },
        "decisions": {
          "type": "string",
          "minLength": 1
        },
        "policy": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "handoff": {
          "type": "string",
          "minLength": 1
        },
        "rounds": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "readme",
        "architecture",
        "backlog",
        "items",
        "decisions",
        "policy",
        "evidence",
        "handoff",
        "rounds"
      ],
      "additionalProperties": false
    },
    "planning": {
      "type": "object",
      "properties": {
        "parallelism": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "parallelism"
      ],
      "additionalProperties": false
    },
    "lanes": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "properties": {
          "exclusive": {
            "type": "boolean"
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "exclusive",
          "resources"
        ],
        "additionalProperties": false
      }
    },
    "verification": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "environment": {
            "type": "string",
            "minLength": 1
          },
          "required": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "command",
          "environment",
          "required"
        ],
        "additionalProperties": false
      }
    },
    "extensions": {
      "type": "object",
      "description": "Project-specific namespaced policy; cannot override core invariants."
    }
  },
  "required": [
    "version",
    "default_branch",
    "remote",
    "paths",
    "planning",
    "lanes",
    "verification"
  ],
  "additionalProperties": false
}
